# Copier en .env et remplir.

# --- Étape 2b : pré-annotation LLM (Claude) ---
# Sans clé, le pipeline retombe sur l'annotateur hors-ligne (gazetteer + regex).
ANTHROPIC_API_KEY=
# Modèle utilisé pour la pré-annotation (par défaut : claude-opus-4-8)
ANNOTATION_MODEL=claude-opus-4-8

# --- Étape 5 : Elasticsearch Cloud ---
# Depuis https://cloud.elastic.co (14 jours gratuits)
ES_CLOUD_ID=
ES_API_KEY=
# Alternative locale (docker) : décommenter
# ES_URL=http://localhost:9200
ES_INDEX=osint_articles
